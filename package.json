{
  "name": "decentralized-lottery",
  "version": "1.0.0",
  "description": "Decentralized Privacy-Preserving Lottery on Midnight Network",
  "type": "module",
  "scripts": {
    "compact-compile": "wsl compactc contracts/lottery.compact managed/lottery",
    "setup": "echo 'Setup complete'",
    "compile": "tsc --noEmit",
    "deploy": "npx tsx src/deploy.ts",
    "network": "npx tsx src/network.ts",
    "cli": "npx tsx src/cli.ts",
    "test": "npx vitest run --config vitest.config.ts",
    "frontend": "npm --prefix frontend run dev",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "^0.16.0",
    "@midnight-ntwrk/dapp-connector-api": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ethers": "^6.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9"
  }
}
